{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.76.2",
    "@supabase/supabase-js": "^2.118.0",
    "nodemailer": "^10.1.5",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "msw": "^2.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
