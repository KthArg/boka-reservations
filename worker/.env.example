# Supabase — service role key para operaciones del worker
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co

# OnvoPay. En producción es OBLIGATORIA (spec 0028): el worker muere al arrancar si
# falta, porque sin ella refunds y reconciliación se estancan en silencio.
ONVOPAY_SECRET_KEY=onvo_test_<your-key>
# Base del API (spec 0028). Default: https://api.onvopay.com/v1 (producción).
# Sandbox: https://api.dev.onvopay.com/v1 (con llaves onvo_test_*).
# ONVOPAY_API_BASE_URL=https://api.dev.onvopay.com/v1

# Email transaccional — ver spec 0007
# dev: EMAIL_PROVIDER=mailpit + SMTP_PORT=54325 (Mailpit del supabase local).
# staging/prod: EMAIL_PROVIDER=resend + RESEND_API_KEY.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Boka Verde <no-reply@localhost>
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
NOTIFICATIONS_ENABLED=true

# Motor del cobro del mínimo (spec 0033). Apagado por defecto: enciende el job
# charge-departures, que autoriza y captura. El flag de la web y el del worker se prenden y se
# apagan juntos; la web encendida con el worker apagado deja reservas que nunca se cobran.
DEFERRED_CHARGE_ENABLED=false
# Marcha atrás: con true el job solo suelta las autorizaciones vivas y cierra los ciclos, sin
# cobrar nada. Sirve para revertir sin dejar plata retenida en las tarjetas.
RELEASE_AUTHORIZATIONS_ONLY=false

# Retención de datos / anonimización de PII (spec 0022). Kill-switch del job
# apply-retention. Dejar en true en producción.
RETENTION_ENABLED=true

# URL pública del sitio (para magic links y links en emails)
APP_URL=http://localhost:3000

NODE_ENV=development

# Sentry — https://sentry.io (opcional, solo se activa en producción)
SENTRY_DSN=
